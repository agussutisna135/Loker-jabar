<button onclick="bagikanLoker()" style="background:#25D366; color:#fff; border:none; padding:10px 16px; border-radius:6px; font-weight:bold; cursor:pointer;">
    📋 Bagikan Info Lowongan
</button>

<script>
function bagikanLoker() {
    // Mengambil judul halaman saat ini dan mengubahnya menjadi format URL (huruf kecil + tanda hubung)
    const slugJudul = document.title
        .split('|')[0] // Hapus nama website di belakang jika ada
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '') // Hapus simbol aneh
        .replace(/\s+/g, '-');         // Ubah spasi jadi tanda hubung (-)

    const formatPesan = `Info Selengkapnya:
lokerjabar.my.id/${slugJudul}

Channel WhatsApp (LokerJabar Terupdate):
://whatsapp.com

Grup Telegram (LokerJabar):
t.me/lokersukabumijabar`;

    navigator.clipboard.writeText(formatPesan).then(() => {
        alert("Link & info berhasil disalin:\n\nlokerjabar.my.id/" + slugJudul);
    });
}
</script>
